# Production (Vercel, ou .env.local pour `npm run build` en local)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Adresse publique : liens absolus, sitemap, aperçus de partage
NEXT_PUBLIC_SITE_URL=https://kuruma.games

